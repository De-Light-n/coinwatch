{
  "info": {
    "name": "Coinwatch Billing Service",
    "description": "Collection of API requests for testing the billing service endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Checkout - Create Stripe Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"plan\": \"pro\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/billing/checkout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "checkout"
          ]
        }
      },
      "response": []
    },
    {
