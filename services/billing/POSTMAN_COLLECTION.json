  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string",
      "description": "JWT token generated from auth service. Format: {\"sub\": \"<uuid>\", \"email\": \"user@example.com\"}"
