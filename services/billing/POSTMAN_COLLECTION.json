    {
      "name": "GET Invoices - Get Invoice History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/billing/invoices?limit=10&offset=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "billing",
            "invoices"
          ],
          "query": [
